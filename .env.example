# ============================================================
# PARMANA OPENAI REFUND AGENT
# ============================================================

# ============================================================
# OPENAI
# ============================================================

OPENAI_API_KEY=
OPENAI_MODEL=

# ============================================================
# PARMANA
# ============================================================

PARMANA_API_URL=https://parmana-api-real.vercel.app
PARMANA_API_KEY=
PARMANA_PRINCIPAL_ID=demo

# ============================================================
# RUNTIME
# ============================================================

PORT=3001
REQUEST_TIMEOUT_MS=10000

# Optional. If set, POST /agent/refund requires "Authorization: Bearer
# <AGENT_API_KEY>". Not part of the minimal spec .env, but strongly
# recommended for any real deployment -- this endpoint spends real
# OpenAI credits and forwards to Parmana on every call. Unset by
# default so the minimal .env above still works.
# AGENT_API_KEY=

# ============================================================
# DO NOT ADD THESE HERE
# ============================================================
# PAYTM_MERCHANT_ID, PAYTM_MERCHANT_KEY, and PAYTM_CONNECTOR_SHARED_SECRET
# belong exclusively to the Paytm connector service
# (pavancharak/parmana-paytm-agent). This agent must never hold them --
# see SECURITY.md and tests/unit/credential-boundary.test.ts, which
# fails the build if any file in src/ ever references them.
